# --- Slack (required) ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# --- Slack channels ---
# Private channel where the bot keeps its memory (queue/session survive restarts). Invite the bot.
STATE_CHANNEL_ID=C0C8H4UAK1S
# Channel that shows one pinned, live-updating status message. Optional. Invite the bot.
STATUS_CHANNEL_ID=C08RLHL052Q
# Comma-separated Slack member IDs allowed to use admin tools.
ADMIN_USER_IDS=U0XXXXXXX

# --- Web dashboard ---
# Public URL of the service, used for dashboard links in Slack messages.
PUBLIC_BASE_URL=https://chargebot-tliw.onrender.com
# Long random string that signs personal dashboard links. Keep it stable.
WEB_SECRET=change-me-to-a-long-random-string
# Secret for the kiosk screen: open /kiosk?k=<KIOSK_KEY> to allow confirming from the screen.
KIOSK_KEY=change-me-too
# How long the dashboard remembers you on a device after you open it from Slack.
# DEVICE_LINK_DAYS=90
# PORT=8080

# --- Chargers and timing (minutes) ---
CHARGERS=Charger 1
# CHARGE_MIN=120
# GRACE_MIN=5
# CONFIRM_MIN=10
# CONFIRM_ALERT_AT_MIN=5,8
# WARN_BEFORE_END_MIN=10
# EXTEND_MIN=30
# MAX_EXTENSIONS=2
# NEXT_UP_HEADS_UP_MIN=15
# NUDGE_COOLDOWN_MIN=5
# TIMEZONE=Asia/Jerusalem

# --- Gmail calendar reminders (optional) ---
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token
GMAIL_FROM_EMAIL=liveuevcharger@gmail.com

# --- Local development only ---
# STATE_FILE=dev.state.json
